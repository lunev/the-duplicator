{
  "name": "the-duplicator",
  "private": true,
  "version": "7.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-icons": "node scripts/generate-icons.js",
    "watch": "npm run generate-icons && NODE_ENV=development vite build --mode development --watch",
    "build": "npm run generate-icons && tsc -b && NODE_ENV=production vite build",
    "release": "npm run build && node scripts/release.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "knip": "knip",
    "jscpd": "jscpd src"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.11",
    "@radix-ui/react-toast": "^1.2.13",
    "@reduxjs/toolkit": "^2.2.7",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@vitest/browser": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nanoid": "^5.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.11.0",
    "redux-persist": "^6.0.0",
    "redux-persist-webextension-storage": "^1.0.2",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.220",
    "@eslint/js": "^9.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/user-event": "^14.6.3",
    "@types/chrome": "^0.0.277",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/redux-persist-webextension-storage": "^1.0.3",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "archiver": "^8.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.9",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^15.11.0",
    "jscpd": "^5.2.0",
    "jsdom": "^25.0.1",
    "knip": "^6.35.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.12.2",
    "vite": "^6.4.1",
    "vitest": "^5.0.0"
  }
