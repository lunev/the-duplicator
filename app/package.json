  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/chrome": "^0.0.277",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
