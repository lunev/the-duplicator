{
  "name": "daily-reminder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development vite build --mode development --watch",
    "build": "tsc -b && NODE_ENV=production vite build && node build-zip.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "build-prev": "node extractZip.js",
    "build-curr": "npm run build -- --outDir ./build-versions"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@vitest/browser": "^3.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.2",
    "redux-persist": "^6.0.0",
    "redux-persist-webextension-storage": "^1.0.2",
    "uuid": "^10.0.0",
    "vite-plugin-static-copy": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/chrome": "^0.0.277",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/redux-persist-webextension-storage": "^1.0.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.0.9",
    "@vitest/ui": "^3.0.9",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "extract-zip": "^2.0.1",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
