{
  "name": "the-duplicator",
  "private": true,
  "version": "7.0.3",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development vite build --mode development --watch",
    "build": "tsc -b && NODE_ENV=production vite build && node build-zip.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "build-curr": "tsc -b && NODE_ENV=production vite build --outDir ./build-versions && node build-zip.js",
    "build-prev": "node extractZip.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.220",
    "@radix-ui/react-alert-dialog": "^1.1.13",
